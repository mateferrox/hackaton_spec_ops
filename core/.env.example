# Copiare in core/.env oppure esportare nello shell prima di `npm run dev`.
SPECOPS_HOST=127.0.0.1
SPECOPS_PORT=3001
SPECOPS_DATA_DIR=./data

# Provider AI — solo per mode connected
# SPECOPS_AI_BASE_URL=https://api.openai.com/v1
# SPECOPS_AI_API_KEY=
# SPECOPS_AI_MODEL=gpt-4o-mini

# Reference / runner HTTP
# SPECOPS_REFERENCE_RUNNER_URL=http://127.0.0.1:3002
# SPECOPS_RUNNER_TOKEN=
# SPECOPS_RUNNERS_JSON={"reference":"http://127.0.0.1:3002"}
