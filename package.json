{
  "name": "specops-mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:core": "SPECOPS_PORT=${SPECOPS_PORT:-3101} npm run dev --prefix core",
    "dev:all": "npm run dev:core & npm run dev",
    "build": "tsc -b && vite build",
    "build:core": "npm run build --prefix core",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:core": "npm test --prefix core",
    "test:all": "npm test --prefix core && vitest run"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
