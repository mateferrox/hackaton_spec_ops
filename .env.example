# SpecOps — variabili server-side (mai nel frontend)

# HTTP core
SPECOPS_HOST=127.0.0.1
SPECOPS_PORT=3001
SPECOPS_DATA_DIR=./data
# SPECOPS_DB_PATH=./data/specops.sqlite

# Provider AI (modalità connected). Lasciare vuoti = PROVIDER_NOT_CONFIGURED.
# SPECOPS_AI_BASE_URL=https://api.openai.com/v1
# SPECOPS_AI_API_KEY=
# SPECOPS_AI_MODEL=gpt-4o-mini

# Runner registry (solo server). Il browser non può passare URL arbitrari.
# SPECOPS_REFERENCE_RUNNER_URL=http://127.0.0.1:3002
# SPECOPS_RUNNER_TOKEN=
# SPECOPS_RUNNERS_JSON={"my-agent":"http://127.0.0.1:3100"}
